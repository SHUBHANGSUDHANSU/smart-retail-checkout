# Non-sensitive local development defaults only. Never add credentials here.

# Camera
SMART_RETAIL_CAMERA_INDEX=0
SMART_RETAIL_CAMERA_WIDTH=1280
SMART_RETAIL_CAMERA_HEIGHT=720
SMART_RETAIL_CAMERA_READ_MAX_ATTEMPTS=30
SMART_RETAIL_CAMERA_READ_RETRY_DELAY_SECONDS=0.1
SMART_RETAIL_CAMERA_MIRROR=true

# YOLO model
SMART_RETAIL_MODEL_PATH=yolov8n.pt
SMART_RETAIL_MODEL_CONFIDENCE_THRESHOLD=0.45
SMART_RETAIL_MODEL_IOU_THRESHOLD=0.70
SMART_RETAIL_MODEL_DEVICE=auto
SMART_RETAIL_MODEL_IMAGE_SIZE=640
SMART_RETAIL_MODEL_ALLOWED_CLASSES=bottle,cup,banana,apple,orange

# ByteTrack
SMART_RETAIL_TRACKER_TYPE=bytetrack
# Optional custom tracker YAML; the packaged default is used when unset.
# SMART_RETAIL_TRACKER_CONFIG_PATH=/absolute/path/to/bytetrack.yaml
SMART_RETAIL_TRACKER_CONFIDENCE_THRESHOLD=0.10
SMART_RETAIL_TRACKER_PERSIST_TRACKS=true

# Checkout state engine
SMART_RETAIL_CHECKOUT_ZONE_LEFT=0.70
SMART_RETAIL_CHECKOUT_ZONE_TOP=0.05
SMART_RETAIL_CHECKOUT_ZONE_RIGHT=0.98
SMART_RETAIL_CHECKOUT_ZONE_BOTTOM=0.95
SMART_RETAIL_CHECKOUT_ZONE_HYSTERESIS=0.015
SMART_RETAIL_CHECKOUT_TRANSITION_CONFIRMATION_FRAMES=3
SMART_RETAIL_CHECKOUT_TRACK_EXPIRY_GRACE_FRAMES=90

# OpenCV UI
SMART_RETAIL_UI_WINDOW_NAME="Smart Retail & Checkout System"
SMART_RETAIL_UI_DEBUG_DISPLAY=false
SMART_RETAIL_UI_SHOW_FPS=true
SMART_RETAIL_UI_NOTIFICATION_DURATION_SECONDS=2.0
SMART_RETAIL_UI_DEBUG_LOG_EVERY_N_FRAMES=15

# Logging. Leave LOG_FILE_PATH empty for console-only logging.
SMART_RETAIL_LOG_LEVEL=INFO
SMART_RETAIL_LOG_FORMAT="%(asctime)s | %(levelname)s | %(name)s | %(message)s"
SMART_RETAIL_LOG_JSON=false
SMART_RETAIL_LOG_FILE_PATH=
SMART_RETAIL_LOG_FILE_MAX_BYTES=5000000
SMART_RETAIL_LOG_FILE_BACKUP_COUNT=3

# Local SQLite checkout history
SMART_RETAIL_DATABASE_ENABLED=true
SMART_RETAIL_DATABASE_PATH=data/smart_retail.db
SMART_RETAIL_DATABASE_BUSY_TIMEOUT_SECONDS=5.0

# Local FastAPI server. Swagger UI is available at /docs.
SMART_RETAIL_API_HOST=127.0.0.1
SMART_RETAIL_API_PORT=8000
SMART_RETAIL_API_ENABLED=true
SMART_RETAIL_API_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Bounded recent-frame window used for latency averages
SMART_RETAIL_METRICS_ROLLING_WINDOW_SIZE=60

# Optional custom product catalog; the packaged default is used when unset.
# SMART_RETAIL_PRODUCTS_CONFIG_PATH=/absolute/path/to/products.json
